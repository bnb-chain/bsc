FROM ethereum/solc:0.6.4-alpine@sha256:39f727ab074268979a342c16843ffcadb0862206be78c0b8413d7c19a13ff3f8

RUN apk add --no-cache ca-certificates npm=10.24.1-r0 nodejs=10.24.1-r0 bash alpine-sdk git

RUN git clone https://github.com/bnb-chain/canonical-upgradeable-bep20.git /usr/app/canonical-upgradeable-bep20 \
    && cd /usr/app/canonical-upgradeable-bep20 \
    && git checkout --detach ca0b6d87b2829641cef654d706f3d24bef420a92

WORKDIR /usr/app/canonical-upgradeable-bep20
COPY docker/truffle-config.js /usr/app/canonical-upgradeable-bep20
COPY docker/solc-0.6.4 /usr/app/canonical-upgradeable-bep20

COPY docker/truffle-cli/package.json docker/truffle-cli/package-lock.json /opt/truffle/
RUN npm ci --prefix /opt/truffle --ignore-scripts --no-audit \
    && ln -s /opt/truffle/node_modules/.bin/truffle /usr/local/bin/truffle
RUN npm ci --ignore-scripts --no-audit

ENTRYPOINT [ "/bin/bash" ]
